{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polylog.dev/schemas/trainer-scenario-1.0.0.json",
  "title": "TrainerScenario",
  "description": "Слой B обменного формата: учебный сценарий для тренажёра возражений, собранный из артефактов звонков или сконструированный вручную.",
  "type": "object",
  "required": ["schema_version", "scenario_id", "spec", "title", "persona", "objections", "success_criteria", "metadata"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "scenario_id": { "type": "string" },
    "spec": { "type": "string", "const": "trainer-scenario/1.0" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": ["string", "null"] },
    "persona": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "type": "string" },
        "company_profile": { "type": ["string", "null"] },
        "temperament": { "type": ["string", "null"] },
        "crm_context": { "type": ["string", "null"], "description": "история общения, стадия сделки — контекст для симуляции" }
      }
    },
    "opening_line": {
      "type": ["object", "null"],
      "properties": {
        "text": { "type": "string" },
        "variant_of": { "type": ["string", "null"], "description": "id возражения/цитаты из артефакта-источника" }
      }
    },
    "objections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "trigger_phrases", "ideal_responses"],
        "properties": {
          "id": { "type": "string" },
          "trigger_phrases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "client_quote_ref": {
            "type": ["object", "null"],
            "description": "трассировка к артефакту-источнику",
            "properties": {
              "artifact_id": { "type": "string" },
              "objection_id": { "type": "string" }
            }
          },
          "ideal_responses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string" },
                "why": { "type": ["string", "null"] }
              }
            }
          },
          "bad_responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string" },
                "why": { "type": ["string", "null"] }
              }
            }
          },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "weight"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 },
          "detection": {
            "type": ["object", "null"],
            "description": "декларативное описание проверки; исполняется движком тренажёра",
            "properties": {
              "kind": { "type": "string", "enum": ["semantic", "regex", "metric"] },
              "hint": { "type": "string" },
              "pattern": { "type": ["string", "null"] },
              "metric": { "type": ["string", "null"] },
              "op": { "type": ["string", "null"] },
              "value": { "type": ["number", "string", "null"] }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["source_call_ids", "language", "license"],
      "properties": {
        "source_call_ids": { "type": "array", "items": { "type": "string" } },
        "industry": { "type": ["string", "null"] },
        "language": { "type": "string", "default": "ru" },
        "license": { "type": "string", "description": "лицензия сценария, например CC-BY-4.0" },
        "anonymization": { "type": "string", "enum": ["none", "mask", "pseudonymize", "redact"] },
        "author": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
