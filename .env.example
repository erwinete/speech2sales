# Полилог — переменные окружения (копировать в .env)
# ВНИМАНИЕ: не коммитить реальный .env (doc 04 §6 — секреты только env/secrets)

POLYLOG_DATABASE_URL=postgresql+asyncpg://polylog:polylog@localhost:5432/polylog
# dev: sqlite+aiosqlite:///./data/polylog-dev.db

POLYLOG_API_TOKEN=change-me-before-production

POLYLOG_INLINE_PROCESS=true
POLYLOG_AUTOCREATE_TABLES=true

POLYLOG_ASR_BACKEND=stub
# после бенчмарка M1 (doc 06 §6): gigaam-v3-rnnt | t-one

POLYLOG_STORAGE_DIR=./data/storage
POLYLOG_TMP_DIR=./data/tmp
POLYLOG_MAX_UPLOAD_MB=200

# Диаризация mono и голосовые отпечатки агентов (DoD М3) — требуют HF_TOKEN
# и моделей с HuggingFace (pyannote). 1 = включено.
# POLYLOG_DIARIZATION=pyannote
# POLYLOG_VOICEPRINT=1
# HF_TOKEN=hf_xxx

# Live-режим «sftp-monitor»: записи качаются с АТС по SFTP (doc 02 §1.2)
# POLYLOG_SFTP_HOST=pbx.example.local
# POLYLOG_SFTP_USER=asterisk
# POLYLOG_SFTP_PASSWORD=
# POLYLOG_SFTP_PORT=22
# POLYLOG_SFTP_KEY_PATH=
# POLYLOG_SFTP_REMOTE_DIR=/var/spool/asterisk/monitor
# POLYLOG_SFTP_PATTERN=*.wav
# POLYLOG_SFTP_NAME_REGEX=(?P<num>\+?\d{6,15})

# Пароли контейнеров compose
POLYLOG_PG_PASSWORD=polylog
POLYLOG_MINIO_PASSWORD=polylog-minio
